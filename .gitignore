# .gitignore for a TypeScript + Playwright project

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript build artifacts
dist/
build/
out/
lib/
*.tsbuildinfo

# Playwright artifacts
playwright-report/
test-results/
trace/
traces/
videos/
screenshots/
.playwright/
playwright/.cache/
playwright/.local-browsers/

# Coverage
coverage/
.nyc_output/

# Logs
logs/
*.log

# Environment files
.env
.env.local
.env.*.local

# Editor directories and files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# OS generated files
.DS_Store
Thumbs.db


# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
